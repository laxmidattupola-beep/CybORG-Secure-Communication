"""Train/evaluate zone-risk classifiers with episode-grouped splits."""
from __future__ import annotations
import json
from pathlib import Path
import numpy as np
import pandas as pd
import joblib
from sklearn.dummy import DummyClassifier
from sklearn.ensemble import RandomForestClassifier, HistGradientBoostingClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.calibration import CalibratedClassifierCV
from sklearn.metrics import (average_precision_score, brier_score_loss, f1_score,
                             precision_score, recall_score, roc_auc_score,
                             confusion_matrix)
from sklearn.model_selection import GroupShuffleSplit

NON_FEATURE_COLUMNS = {"episode_id", "step", "zone", "evaluation_stratum_compromised", "strategy", "topology_family"}


def feature_columns(frame):
    return [c for c in frame.columns if c not in NON_FEATURE_COLUMNS and not c.endswith("_risk_3")
            and not c.endswith("_risk_5") and not c.endswith("_risk_10")]


def split_episode_ids(frame, seed=42, test_size=0.2, validation_size=0.2):
    episodes = np.asarray(sorted(frame["episode_id"].unique()))
    if len(episodes) < 5:
        raise ValueError(f"Need at least 5 distinct episodes for train/validation/test; got {len(episodes)}")
    first = GroupShuffleSplit(n_splits=1, test_size=test_size, random_state=seed)
    trainval_idx, test_idx = next(first.split(episodes, groups=episodes))
    trainval = episodes[trainval_idx]; test = episodes[test_idx]
    val_fraction = validation_size / (1.0 - test_size)
    second = GroupShuffleSplit(n_splits=1, test_size=val_fraction, random_state=seed + 1)
    train_idx, val_idx = next(second.split(trainval, groups=trainval))
    return {"train": trainval[train_idx].tolist(), "validation": trainval[val_idx].tolist(), "test": test.tolist()}


def _safe_probability(model, X):
    if hasattr(model, "predict_proba"):
        p = model.predict_proba(X)
        classes = list(model.classes_)
        return p[:, classes.index(1)] if 1 in classes else np.zeros(len(X), dtype=float)
    return np.asarray(model.predict(X), dtype=float)


def metrics_for(y_true, probability, threshold=0.5):
    y_true = np.asarray(y_true, dtype=int); probability = np.asarray(probability, dtype=float)
    pred = probability >= threshold
    tn, fp, fn, tp = confusion_matrix(y_true, pred, labels=[0,1]).ravel()
    result = {"n": int(len(y_true)), "positive_count": int(y_true.sum()),
              "prevalence": float(y_true.mean()) if len(y_true) else 0.0,
              "precision": float(precision_score(y_true, pred, zero_division=0)),
              "recall": float(recall_score(y_true, pred, zero_division=0)),
              "f1": float(f1_score(y_true, pred, zero_division=0)),
              "false_positive_rate": float(fp / max(1, fp + tn)),
              "missed_attack_rate": float(fn / max(1, fn + tp)),
              "brier_score": float(brier_score_loss(y_true, probability)) if len(y_true) else None,
              "true_positive": int(tp), "false_positive": int(fp), "true_negative": int(tn), "false_negative": int(fn)}
    result["average_precision"] = float(average_precision_score(y_true, probability)) if len(np.unique(y_true)) > 1 else None
    result["roc_auc"] = float(roc_auc_score(y_true, probability)) if len(np.unique(y_true)) > 1 else None
    return result


def build_models(seed=42):
    return {
        "base_rate": DummyClassifier(strategy="prior"),
        "logistic_regression": LogisticRegression(max_iter=2000, class_weight="balanced", random_state=seed),
        "random_forest": RandomForestClassifier(n_estimators=300, min_samples_leaf=3, class_weight="balanced_subsample", n_jobs=-1, random_state=seed),
        "gradient_boosting": HistGradientBoostingClassifier(max_iter=150, learning_rate=0.08, l2_regularization=1.0, random_state=seed),
    }


def train_dataset(dataset_path, output_dir, seed=42, windows=(3,5,10), target_prefix="attack_risk"):
    frame = pd.read_csv(dataset_path)
    required = {"episode_id", "step", "zone"}
    if not required.issubset(frame.columns): raise ValueError(f"Dataset missing required columns: {required - set(frame.columns)}")
    split = split_episode_ids(frame, seed=seed)
    output_dir = Path(output_dir); output_dir.mkdir(parents=True, exist_ok=True)
    (output_dir / "episode_split.json").write_text(json.dumps(split, indent=2), encoding="utf-8")
    features = feature_columns(frame)
    # Numeric-only inputs; evaluation-stratum and labels are explicitly excluded.
    X_all = frame[features].apply(pd.to_numeric, errors="coerce").replace([np.inf,-np.inf], np.nan).fillna(0.0)
    records = []
    for window in windows:
        target = f"{target_prefix}_{window}"
        if target not in frame: raise ValueError(f"Missing target column {target}")
        y_all = frame[target].astype(int)
        ids = {name: set(values) for name, values in split.items()}
        train_mask = frame.episode_id.isin(ids["train"])
        val_mask = frame.episode_id.isin(ids["validation"])
        test_mask = frame.episode_id.isin(ids["test"])
        if y_all[train_mask].nunique() < 2:
            raise ValueError(f"Training target {target} contains only one class; collect more episodes/events")
        for model_name, model in build_models(seed).items():
            model.fit(X_all.loc[train_mask], y_all.loc[train_mask])
            # Calibrate non-prior models on held-out validation episodes when both classes exist.
            if model_name != "base_rate" and y_all[val_mask].nunique() == 2:
                try:
                    calibrated = CalibratedClassifierCV(model, method="sigmoid", cv="prefit")
                    calibrated.fit(X_all.loc[val_mask], y_all.loc[val_mask])
                    model = calibrated
                except (ValueError, TypeError):
                    pass
            probability = _safe_probability(model, X_all.loc[test_mask])
            metric = metrics_for(y_all.loc[test_mask], probability)
            records.append({"window": window, "target": target, "model": model_name, **metric})
            joblib.dump({"model": model, "feature_columns": features, "target": target,
                         "window": window, "seed": seed, "split_episode_ids": split,
                         "feature_policy": "zone-local observations only; no simulator truth or labels"},
                        output_dir / f"{model_name}_{target}.joblib")
    report = pd.DataFrame(records)
    report.to_csv(output_dir / "heldout_metrics.csv", index=False)
    return report
